# Copy to .env and adjust.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "postgres" (default) or "sqlite" for a zero-setup local run
DB_ENGINE=postgres
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS (comma separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Seed admin (used by `python manage.py seed_data`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Employee API demo: True = public demo CRUD, False = admin JWT required
EMPLOYEE_DEMO_PUBLIC=True

# Throttling
CONTACT_THROTTLE_RATE=10/hour
LOGIN_THROTTLE_RATE=20/hour

# AWS S3 for project images (set USE_S3=True to enable)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Contact email notifications (optional)
CONTACT_NOTIFY_ENABLED=False
CONTACT_NOTIFY_TO=you@example.com
DEFAULT_FROM_EMAIL=portfolio@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
